# VaaniRAG Configuration - HH Goa 2026

# Sarvam AI Credentials (Optional: if empty, local grounded synthesis is used)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Embedding & Vector Database (CPU-optimized default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_LIMIT=10000

# Retrieval & Reranking Hyperparameters
TOP_K=10
FINAL_K=5
SEMANTIC_WEIGHT=0.7
BM25_WEIGHT=0.3
RETRIEVAL_THRESHOLD=0.28

# System Performance & Caching
CACHE_SIZE=1000
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
